    {
      "name": "Get Access token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseGenerateToken = pm.response.json();\r",
              "\r",
              "\r",
              "const instanceURL = responseGenerateToken.instance_url;\r",
              "pm.globals.set(\"instance_url\", instanceURL);\r",
              "console.log(\"Instance URL:\", instanceURL);\r",
              "\r",
              "\r",
              "const accessToken = responseGenerateToken.access_token;\r",
              "pm.collectionVariables.set(\"access_token\", accessToken);\r",
              "console.log(\"Access Token:\", accessToken);\r",
              "\r",
              "let res_token_env = pm.response.json().access_token;\r",
              "\r",
              "pm.environment.set(\"access_Token\", res_token_env);\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
